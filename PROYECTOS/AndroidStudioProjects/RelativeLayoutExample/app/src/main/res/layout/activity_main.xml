<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RelativeLayout"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp" />

    <!-- First Name Label -->
    <TextView
        android:id="@+id/labelFirstName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Name:"
        android:layout_below="@id/textTitle"
        android:layout_marginTop="24dp" />

    <!-- First Name EditText -->
    <EditText
        android:id="@+id/editFirstName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter First Name"
        android:layout_toEndOf="@id/labelFirstName"
        android:layout_alignBaseline="@id/labelFirstName"
        android:layout_marginStart="8dp" />

    <!-- Second Name Label -->
    <TextView
        android:id="@+id/labelSecondName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Second Name:"
        android:layout_below="@id/editFirstName"
        android:layout_marginTop="16dp" />

    <!-- Second Name EditText -->
    <EditText
        android:id="@+id/editSecondName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Second Name"
        android:layout_toEndOf="@id/labelSecondName"
        android:layout_alignBaseline="@id/labelSecondName"
        android:layout_marginStart="8dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/buttonSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:layout_below="@id/editSecondName"
        android:layout_alignParentStart="true"
        android:layout_marginTop="24dp" />

    <!-- Reset Button -->
    <Button
        android:id="@+id/buttonReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:layout_toEndOf="@id/buttonSubmit"
        android:layout_alignBaseline="@id/buttonSubmit"
        android:layout_marginStart="16dp" />

</RelativeLayout>
